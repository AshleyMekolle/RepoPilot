      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "08ef323b-7960-4c7f-8515-fe972aeb6df8",
              "name": "notification_icon",
              "type": "string",
              "value": "={{ $json.ci_status === \"failure_detected\" ? \"🚨\" : $json.event_type === \"workflow_error\" ? \"⚠️\" : \"🏷️\" }}"
            },
            {
              "id": "a6a1e501-6bcf-4ec2-a8d8-208012c593f9",
              "name": "notification_title",
              "type": "string",
              "value": "={{ $json.ci_status === \"failure_detected\"\n  ? \"CI Failure: \" + ($json.workflow_name || \"Unknown workflow\")\n  : $json.event_type === \"workflow_error\"\n    ? \"RepoPilot Error: \" + ($json.error_workflow || \"Unknown workflow\")\n    : \"Issue Triage: \" + ($json.issue_title || \"Unknown issue\") }}"
            },
            {
              "id": "e7f8d6bc-1c68-4bd1-b556-b9430d404b21",
              "name": "notification_message",
              "type": "string",
              "value": "={{\n  $json.ci_status === \"failure_detected\"\n    ? \"Repository: \" + ($json.repository || \"Unknown\") +\n      \"\\nWorkflow: \" + ($json.workflow_name || \"Unknown\") +\n      \"\\nConclusion: \" + ($json.workflow_conclusion || \"Unknown\") +\n      \"\\nRun: \" + ($json.failure_url || \"No URL available\")\n  : $json.event_type === \"workflow_error\"\n    ? \"Failed node: \" + ($json.error_node || \"Unknown\") +\n      \"\\nError: \" + ($json.error_message || \"Unknown error\") +\n      \"\\nTime: \" + ($json.error_time || \"Unknown\") +\n      \"\\nExecution: \" + ($json.error_execution_url || \"No URL available\")\n    : \"Repository: \" + ($json.repository || \"Unknown\") +\n      \"\\nIssue #\" + ($json.issue_number ?? \"Unknown\") +\n      \": \" + ($json.issue_title || \"Untitled\") +\n      \"\\nCategory: \" + ($json.suggested_category || \"Unclassified\") +\n      \"\\nPriority: \" + ($json.suggested_priority || \"Unassigned\") +\n      \"\\nLabels: \" + (\n        Array.isArray($json.suggested_labels)\n          ? $json.suggested_labels.join(\", \")\n          : JSON.parse($json.suggested_labels || \"[]\").join(\", \")\n      ) +\n      \"\\nReason: \" + ($json.triage_reason || \"Not provided\")\n}}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
