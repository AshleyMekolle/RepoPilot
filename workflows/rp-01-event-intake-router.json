    {
      "parameters": {
        "jsCode": "// Verifies GitHub's X-Hub-Signature-256 header (HMAC-SHA256 of the raw request body)\nconst crypto = require('crypto');\n\n// Must match the Secret set in GitHub > Settings > Webhooks\nconst secret = 'YOUR_GITHUB_WEBHOOK_SECRET';\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst received = headers['x-hub-signature-256'] || '';\n\n// Raw body bytes, kept by the Webhook node's \"Raw Body\" option\nconst rawBody = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', secret)\n  .update(rawBody)\n  .digest('hex');\n\nconst a = Buffer.from(received);\nconst b = Buffer.from(expected);\nconst signatureValid = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nreturn [{\n  json: { ...item.json, signature_valid: signatureValid },\n  binary: item.binary,\n}];"
      },
