    {
      "parameters": {
        "promptType": "define",
        "text": "=Repository: {{ $json.repository }}\nIssue number: {{ $json.issue_number }}\nTitle: {{ $json.issue_title }}\nBody: {{ $json.issue_body }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are RepoPilot, an expert GitHub issue triage assistant.  Analyze the issue title and body. Classify it conservatively.  Return: - category: exactly one of bug, feature, documentation, needs-review - priority: exactly one of high, medium, low - labels: an array containing appropriate labels from bug, enhancement, documentation, needs-review, priority-high, priority-medium, priority-low - reason: one concise sentence explaining the classification  Priority rules: - high: confirmed or strongly indicated security risk, data loss, production outage, or urgent critical issue - medium: a meaningful bug or problem affecting functionality - low: ordinary feature requests, documentation changes, and minor improvements  Do not invent facts. If the issue is unclear, use needs-review and explain why."
            }
          ]
        },
        "batching": {}
      },
